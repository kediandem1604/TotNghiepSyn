# Chép file này thành .env.local rồi điền (file .env.local không bị đưa lên git)

# Mật khẩu trang quản lí khi chạy trên máy (npm run dev). Để trống thì dùng "thiep-dev".
ADMIN_PASSWORD=

# Địa chỉ trang sau khi đưa lên mạng, dùng cho ảnh xem trước khi gửi link (không bắt buộc).
# Netlify tự điền khi deploy bằng `npm run deploy`.
SITE_URL=
